POSTGRES_DB=ai_series
POSTGRES_USER=ai_series
POSTGRES_PASSWORD=change_me_locally
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_ENV=development

# groq | openai | deepseek
AI_PROVIDER=deepseek
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# enabled | disabled (thinking mode; enabled = дороже, медленнее, потенциально точнее)
DEEPSEEK_THINKING=disabled

AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=8192

# Worker
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=300
TASK_MAX_ATTEMPTS=4

# Phase 2: после анализа персонажей автоматически извлекать события и локации
# (второй проход по книге ≈ ещё столько же запросов к LLM)
STORY_AUTO_ENQUEUE=true
